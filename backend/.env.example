# Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/fitness_backend_db?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_sixforge_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_sixforge_2026
JWT_REFRESH_EXPIRES_IN=30d

# Storage (local | s3 | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
